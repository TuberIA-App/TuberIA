{
  "name": "tuberia",
  "version": "1.0.0",
  "description": "TuberIA monorepo root - AI-powered YouTube channel summarisation",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build --watch",
    "dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "dev:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml logs -f",
    "prod:local": "./scripts/local-prod.sh",
    "prod:local:down": "./scripts/local-prod.sh down",
    "build": "pnpm --recursive --if-present build",
    "test": "pnpm --recursive --if-present test",
    "test:all": "pnpm --recursive --if-present test:all",
    "test:integration": "pnpm --recursive --if-present test:integration",
    "lint": "pnpm --recursive --if-present lint",
    "ports": "./scripts/check-ports.sh",
    "reset": "pnpm --recursive exec rm -rf node_modules dist && rm -rf node_modules"
  },
  "keywords": [
    "youtube",
    "ai",
    "summarisation",
    "monorepo"
  ]
}
