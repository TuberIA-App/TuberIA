# ============================================================================
# TuberIA - Docker Compose environment
# ============================================================================
# Copy to `.env` (gitignored) and adjust:
#     cp .env.example .env
#
# This file configures COMPOSE: project name, published ports, images and
# resource limits. APPLICATION secrets live in `backend/.env`
# (see backend/.env.example). The two files are deliberately separate.
# ============================================================================


# ============================================================================
# 1. Project identity
# ============================================================================
# Namespaces every container, network and volume, and pins the name so that
# renaming the checkout directory cannot make `down` and `up` target two
# different projects (which strands the data volume).
COMPOSE_PROJECT_NAME=tuberia

# Makes a bare `docker compose up` load the dev overlay, so nobody has to
# remember two -f flags. Production passes its own -f flags explicitly.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml


# ============================================================================
# 2. Port allocation  *** READ THIS ***
# ============================================================================
# TuberIA owns the contiguous block 7100-7105. It collides with no common
# default (5173 Vite, 5432/5433/5434 Postgres, 6379 Redis, 27017 Mongo,
# 3000/8080 everything else) and sits well below this kernel's ephemeral port
# range (net.ipv4.ip_local_port_range = 32768-60999), so a static bind here can
# never race an outbound connection.
#
# NAMING: every variable ends in _HOST_PORT. Do NOT shorten them to
# REDIS_PORT / BACKEND_PORT. Those names are ALSO used by the backend
# application (backend/.env) with completely different values - REDIS_PORT
# there means 6379, the port *inside* the Docker network. Since
# scripts/check-ports.sh sources this file into your shell, a short name would
# leak a host port into the app's config and point it at a nonexistent Redis.
#
# HOST_BIND_ADDR is prefixed to every published port and defaults to loopback:
#   Docker writes its own iptables DNAT rules that BYPASS ufw/firewalld
#   entirely. A port published as "5000:5000" is reachable from the LAN and
#   often the internet even when `ufw status` says that port is denied.
#   "127.0.0.1:5000:5000" is immune - the kernel will not route external
#   traffic to a loopback address.
HOST_BIND_ADDR=127.0.0.1

# --- Application ---
FRONTEND_HOST_PORT=7100
BACKEND_HOST_PORT=7101

# --- Datastores (local debugging only; NEVER published in production) ---
MONGO_HOST_PORT=7102
REDIS_HOST_PORT=7103

# --- Edge proxy (Caddy). Production binds 0.0.0.0:80/443 and ignores these. --
CADDY_HTTP_PORT=7104
CADDY_HTTPS_PORT=7105


# ============================================================================
# 3. Images (production only)
# ============================================================================
# Production PULLS images built by GitHub Actions; it never builds. A `vite
# build` plus `pnpm install` on a 2 GB VPS competes for RAM with mongod and
# reliably gets it OOM-killed.
#
# GHCR_OWNER must match the owner of the GitHub repository the images are
# pushed from, LOWERCASED - GHCR rejects uppercase in an image path. The deploy
# workflow publishes to ghcr.io/<owner>/tuberia-{backend,frontend}, so if the
# repository is ever transferred to another org, change this to match or every
# `docker compose pull` will 404.
GHCR_OWNER=obezeq

# Immutable tag to deploy. CI sets this to the commit SHA; keeping a real SHA
# here (not "latest") is what makes rollback a one-line change.
IMAGE_TAG=latest


# ============================================================================
# 4. Domain / TLS (production only)
# ============================================================================
DOMAIN_NAME=localhost
SSL_EMAIL=admin@example.com


# ============================================================================
# 5. Database credentials (containerised MongoDB)
# ============================================================================
# Initialises the Mongo container. The backend builds its own connection
# string from these in the compose file - CHANGE THEM before deploying.
MONGO_USER=mongo
MONGO_PASSWORD=mongo
MONGO_DB=tuberia_db


# ============================================================================
# 6. Redis tuning
# ============================================================================
# maxmemory covers the DATASET ONLY - it excludes client buffers and the
# copy-on-write pages of the fork() an AOF rewrite performs. It must stay well
# below the container's mem_limit (256m in prod), or the kernel OOM-kills Redis
# before Redis can apply its own policy. ~2.6x headroom is the safe ratio.
#
# The eviction policy is pinned to `noeviction` in the compose file and must
# stay there: BullMQ keeps job state in Redis, so any eviction policy silently
# destroys queued and in-flight jobs.
REDIS_MAXMEMORY=96mb


# ============================================================================
# Quick start
# ============================================================================
#   cp .env.example .env
#   cp backend/.env.example backend/.env      # then fill in the secrets
#   ./scripts/check-ports.sh                  # confirm the block is free
#   pnpm dev
#
#   Frontend  -> http://127.0.0.1:7100
#   Backend   -> http://127.0.0.1:7101/health
# ============================================================================
