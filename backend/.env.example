# ============================================================================
# TuberIA Backend - application configuration and secrets
# ============================================================================
#   cp backend/.env.example backend/.env
#   chmod 600 backend/.env
#
# NEVER commit a .env file with real credentials.
#
# This file holds APPLICATION config. Compose config - published ports, image
# tags, the domain - lives in the root .env instead. Keep them separate: the
# root .env is sourced into your shell by scripts/check-ports.sh, and a
# variable named REDIS_PORT in both files would mean two different things.
#
# Every value below is read from the process environment. There is no Docker
# secrets path: one mechanism for every environment means one place to look
# when something is missing.
# ============================================================================

# Server configuration
NODE_ENV=development
PORT=5000

# ============================================
# Database Configuration
# ============================================
# Hostname `mongo` is the Compose service name, resolvable inside the network.
#
# authSource=admin is REQUIRED and easy to get wrong: MONGO_INITDB_ROOT_USERNAME
# creates the user in the `admin` database, not in the application database, so
# authenticating against `tuberia_db` fails with "Authentication failed".
#
# Credentials must match MONGO_USER / MONGO_PASSWORD in the root .env.
MONGODB_URI=mongodb://mongo:mongo@mongo:27017/tuberia_db?authSource=admin

# For a MongoDB running directly on your machine, without auth:
# MONGODB_URI=mongodb://127.0.0.1:27017/tuberia

# Test database (used by the test suite)
MONGODB_TEST_URI=mongodb://mongo:mongo@mongo:27017/tuberia-test?authSource=admin

# ============================================
# JWT Configuration
# ============================================
# Generate real values - the app REFUSES TO START if either is shorter than 32
# characters, if both are identical, or if the placeholder below survives:
#
#   echo "JWT_SECRET=$(openssl rand -hex 32)"         >> backend/.env
#   echo "JWT_REFRESH_SECRET=$(openssl rand -hex 32)" >> backend/.env
#
# They must differ from each other: reusing one key for both token types lets a
# leaked access token be replayed as a refresh token.
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-32-characters-long-please-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-must-be-at-least-32-characters-long-change-this-too
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# External APIs
# ============================================
# OpenRouter API key for AI summarization
# Get yours at: https://openrouter.ai/
OPENROUTER_API_KEY=your_api_key_here

# ============================================
# CORS & Frontend
# ============================================
# Origin the browser sends, used for CORS. In development that is the port the
# frontend is PUBLISHED on (see FRONTEND_HOST_PORT in the root .env), not 5173.
FRONTEND_URL=http://127.0.0.1:7100

# ============================================
# Redis Configuration
# ============================================
# `redis` is the Compose service name. Use 127.0.0.1 only if you run Redis
# directly on your machine rather than in the stack.
REDIS_HOST=redis

# The port INSIDE the Docker network - always 6379. This is NOT the host port
# the container is published on (REDIS_HOST_PORT in the root .env, default
# 7103). Setting this to the host port is a classic way to get
# ECONNREFUSED from every queue operation.
REDIS_PORT=6379
# Password (if set in production)
# REDIS_PASSWORD=

# ============================================
# Worker Configuration
# ============================================
WORKER_CONCURRENCY=2
RSS_POLL_INTERVAL=30

# ============================================
# Logging
# ============================================
# Options: error, warn, info, debug
LOG_LEVEL=info

# ============================================
# YouTube Proxy Configuration (Optional)
# ============================================
# Leave empty to disable proxy usage (will use rotative user agents only)
# Format: http://USERNAME:PASSWORD@IP:PORT or http://IP:PORT
# Example: http://myuser:mypass@123.456.789.012:8080
YOUTUBE_PROXY_URL=

# YouTube Transcription Retry Settings
# Number of retry attempts if transcription fails (default: 3)
YOUTUBE_TRANSCRIPT_MAX_RETRIES=3
# Delay between retries in milliseconds (default: 1000)
YOUTUBE_TRANSCRIPT_RETRY_DELAY=1000

# ============================================
# Observability (Optional)
# ============================================
# Sentry DSN for error tracking
# Get yours at: https://sentry.io/
# Leave empty to disable Sentry
SENTRY_DSN=
